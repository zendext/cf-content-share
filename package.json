{
  "name": "cf-content-share",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "worker-build --release",
    "test": "npm run build && node --test tests/*.test.mts",
    "dev": "wrangler dev --config wrangler.local.jsonc",
    "check": "npm run lint && npm run check:types && npm test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "dry-run": "wrangler deploy --dry-run --config wrangler.local.jsonc",
    "init:cloud": "node scripts/init-cloud.mts",
    "test:deployment": "node --test tests/deployment.test.mts",
    "check:types": "tsc --noEmit && tsc --project tsconfig.workerd.json",
    "lint": "biome check . --error-on-warnings && cargo fmt --check && cargo clippy --target wasm32-unknown-unknown -- -D warnings",
    "format": "biome check --write . && cargo fmt"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261006.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.2",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "license": "Apache-2.0"
}
