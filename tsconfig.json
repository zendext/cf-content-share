{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/**/*.mts",
    "skills/**/*.mts",
    "tests/**/*.mts"
  ],
  "exclude": [
    "tests/*-fixture.mts"
  ]
}
